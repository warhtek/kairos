<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📖 La Santa Biblia"
        android:textColor="#3B82F6"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Versículo del día"
        android:textColor="#666666"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/widget_verse_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proverbios 3:5"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/widget_verse_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pon toda tu esperanza en Dios, y no te apoyes en tu propia inteligencia."
        android:textColor="#555555"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="12dp" />

</LinearLayout>
